"""
DPSL (SL-DP) defence sweep
--------------------------
Reproduces the Gaussian-mechanism baseline of

    N. D. Pham, K. T. Phan, N. Chilamkurti,
    "Enhancing Accuracy-Privacy Trade-off in Differentially Private
     Split Learning", arXiv:2310.14434

and evaluates it against every attack in this repo that the mechanism
can actually affect.

WHAT DPSL CAN AND CANNOT DEFEND
-------------------------------
DPSL perturbs the FORWARD smashed data. It therefore applies to:
    white-box inversion, UnSplit, AE-decoder, FSHA
It provably CANNOT affect:
    label leakage      (operates on backward gradients)
    backdoor client    (trigger applied to raw input, before the split)
    backdoor server    (server weights poisoned, smashed data irrelevant)
VILLAIN is partial: the additive embedding trigger may be disrupted by
noise, but the label-inference phase uses gradients and is unprotected.

The 'not covered' rows are still recorded, with defended == undefended,
because showing that a forward-pass defence leaves half the attack
surface untouched is a result worth reporting.

USAGE
-----
    python defence_runner/run_dpsl_sweep.py --model PyramidCNN \
        --dataset CIFAR10 --cuts 2 3 4 --epsilons 2 3 5 --seed 0
"""

import os
import sys
import csv
import copy
import argparse
import datetime
import subprocess

import torch

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from config import Config
from all_defences.dpsl_defense import DPSLDefense
from all_defences.defended_client import DefendedClient


# --------------------------------------------------------------------------
# attack coverage map — which attacks DPSL can influence
# --------------------------------------------------------------------------
FORWARD_ATTACKS = ['WhiteBox', 'UnSplit', 'AE_Decoder', 'FSHA']
PARTIAL_ATTACKS = ['VILLAIN']
UNCOVERED_ATTACKS = ['LabelLeakage', 'Backdoor_Client', 'Backdoor_Server']


def git_hash():
    try:
        return subprocess.check_output(
            ['git', 'rev-parse', '--short', 'HEAD'],
            stderr=subprocess.DEVNULL).decode().strip()
    except Exception:
        return 'nogit'


def set_seed(seed):
    import random
    import numpy as np
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)


def build_models(device):
    """Instantiate client/server pair for the model named in Config."""
    name = Config.MODEL_NAME
    in_ch = 1 if Config.DATASET == 'MNIST' else 3

    if name == 'PyramidCNN':
        from all_model.pyramid_cnn import (PyramidCNNClientModel,
                                           PyramidCNNServerModel)
        client = PyramidCNNClientModel(in_channels=in_ch,
                                       cut_layer=Config.CUT_LAYER)
        server = PyramidCNNServerModel(num_classes=Config.NUM_CLASSES,
                                       cut_layer=Config.CUT_LAYER)
    elif name == 'KAGN':
        from all_model.kagn_models import KAGNClientModel, KAGNServerModel
        client = KAGNClientModel(in_channels=in_ch,
                                 cut_layer=Config.CUT_LAYER,
                                 degree=Config.DEGREE)
        server = KAGNServerModel(num_classes=Config.NUM_CLASSES,
                                 cut_layer=Config.CUT_LAYER,
                                 degree=Config.DEGREE)
    else:
        from all_model.models import ClientModel, ServerModel
        client = ClientModel(in_channels=in_ch)
        server = ServerModel(num_classes=Config.NUM_CLASSES)

    return client.to(device), server.to(device)


def train_with_defense(defense, train_loader, test_loader, device):
    """Train a fresh split model with the defence ACTIVE in the loop."""
    from all_split_learning.split_learning import SplitLearningTrainer

    client, server = build_models(device)

    # materialise lazy layers before training
    img = 28 if Config.DATASET == 'MNIST' else 32
    in_ch = 1 if Config.DATASET == 'MNIST' else 3
    with torch.no_grad():
        dummy = torch.zeros(2, in_ch, img, img, device=device)
        smashed = client(dummy)
        if defense is not None:
            smashed = defense.protect(smashed)
        server(smashed)

    trainer = SplitLearningTrainer(client_model=client,
                                   server_model=server,
                                   train_loader=train_loader,
                                   test_loader=test_loader,
                                   defense=defense)
    trainer.train()
    trainer.save_results()
    return client, server, max(trainer.test_accuracies)


def run_forward_attacks(client, server, defense, train_loader,
                        test_loader, device):
    """
    Run every forward-pass attack against the DEFENDED client.

    The wrapper is the whole trick: attacks call client(x) and receive
    clamped+noised smashed data, exactly as a real adversary would.
    """
    results = {}
    defended = DefendedClient(client, defense, active=(defense is not None))

    # ---- white-box inversion ----
    try:
        from all_attacks.attacks_whitebox import run_whitebox_attack
        psnr, ssim = run_whitebox_attack(defended, test_loader, device,
                                         dataset=Config.DATASET,
                                         num_images=32, iterations=1000)
        results['WhiteBox'] = {'psnr': psnr, 'ssim': ssim}
    except Exception as exc:
        results['WhiteBox'] = {'error': str(exc)}

    # ---- UnSplit ----
    try:
        from all_attacks.attack_unsplit import UnSplitAttack
        attacker = UnSplitAttack(defended, dataset=Config.DATASET)
        summary = attacker.attack(test_loader, num_batches=1)
        results['UnSplit'] = summary
    except Exception as exc:
        results['UnSplit'] = {'error': str(exc)}

    # ---- AE decoder ----
    try:
        from all_attacks.ae_decoder_attack import run_ae_decoder_attack
        summary = run_ae_decoder_attack(defended, train_loader, test_loader,
                                        device, Config.DATASET,
                                        label=f'{Config.MODEL_NAME} AE')
        results['AE_Decoder'] = summary
    except Exception as exc:
        results['AE_Decoder'] = {'error': str(exc)}

    # ---- FSHA ----
    # NOTE: Gawron & Stubbings [21] found DP does NOT stop FSHA at any
    # epsilon. Expect this row to show little or no protection. That is a
    # reportable negative result, not a bug.
    try:
        from all_attacks.fsha_attack import FSHAAttack
        in_ch = 1 if Config.DATASET == 'MNIST' else 3
        fsha = FSHAAttack(copy.deepcopy(client), in_channels=in_ch,
                          dataset=Config.DATASET)
        fsha.client_model = DefendedClient(fsha.client_model, defense,
                                           active=(defense is not None))
        fsha.hijack(train_loader, test_loader, epochs=50)
        results['FSHA'] = fsha.reconstruct(test_loader)
    except Exception as exc:
        results['FSHA'] = {'error': str(exc)}

    return results


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--model', default='PyramidCNN',
                        choices=['PyramidCNN', 'KAGN', 'Vanilla_SL'])
    parser.add_argument('--dataset', default='CIFAR10',
                        choices=['MNIST', 'CIFAR10'])
    parser.add_argument('--cuts', type=int, nargs='+', default=[2, 3, 4])
    parser.add_argument('--epsilons', type=float, nargs='+',
                        default=[2, 3, 5])
    parser.add_argument('--delta', type=float, default=1e-5)
    parser.add_argument('--seed', type=int, default=0)
    parser.add_argument('--out', default='./results/dpsl_sweep.csv')
    args = parser.parse_args()

    Config.MODEL_NAME = args.model
    Config.DATASET = args.dataset
    Config.RUN_ATTACK = True

    device = torch.device(Config.DEVICE if torch.cuda.is_available() else 'cpu')
    os.makedirs(os.path.dirname(args.out), exist_ok=True)

    fieldnames = ['timestamp', 'git_hash', 'model', 'dataset', 'cut_layer',
                  'seed', 'defense', 'epsilon', 'sigma', 'accuracy',
                  'attack', 'metric', 'value', 'covered']

    write_header = not os.path.exists(args.out)
    handle = open(args.out, 'a', newline='')
    writer = csv.DictWriter(handle, fieldnames=fieldnames)
    if write_header:
        writer.writeheader()

    def record(cut, eps, sigma, acc, attack, metric, value, covered):
        writer.writerow({
            'timestamp': datetime.datetime.now().isoformat(timespec='seconds'),
            'git_hash': git_hash(), 'model': args.model,
            'dataset': args.dataset, 'cut_layer': cut, 'seed': args.seed,
            'defense': 'none' if eps is None else 'DPSL',
            'epsilon': '' if eps is None else eps,
            'sigma': '' if sigma is None else round(sigma, 4),
            'accuracy': round(acc, 2), 'attack': attack,
            'metric': metric, 'value': value, 'covered': covered})
        handle.flush()

    from dataset import DatasetLoader

    for cut in args.cuts:
        Config.CUT_LAYER = cut

        # epsilon = None is the undefended baseline
        for eps in [None] + list(args.epsilons):
            set_seed(args.seed)
            Config.RUN_TAG = ('nodef' if eps is None
                              else f'dpsl_eps{eps:g}') + f'_s{args.seed}'

            defense = None if eps is None else DPSLDefense(epsilon=eps,
                                                           delta=args.delta)
            sigma = None if defense is None else defense.sigma

            print('\n' + '=' * 70)
            print(f'  {args.model} | {args.dataset} | cut {cut} | '
                  f'{"NO DEFENCE" if eps is None else f"DPSL eps={eps} sigma={sigma:.3f}"}')
            print('=' * 70)

            train_loader, test_loader = DatasetLoader(Config.DATASET).get_loaders()

            client, server, acc = train_with_defense(
                defense, train_loader, test_loader, device)

            record(cut, eps, sigma, acc, 'utility', 'test_accuracy', acc, 'n/a')

            attack_results = run_forward_attacks(
                client, server, defense, train_loader, test_loader, device)

            for name, summary in attack_results.items():
                if 'error' in summary:
                    record(cut, eps, sigma, acc, name, 'error',
                           summary['error'][:120], 'yes')
                    continue
                for metric, value in summary.items():
                    record(cut, eps, sigma, acc, name, metric,
                           round(float(value), 5), 'yes')

            for name in UNCOVERED_ATTACKS:
                record(cut, eps, sigma, acc, name, 'note',
                       'DPSL cannot affect this channel', 'no')

    handle.close()
    print(f'\n  Sweep complete. Results appended to {args.out}')


if __name__ == '__main__':
    main()